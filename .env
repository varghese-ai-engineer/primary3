# ------------------------------------------------------------------
# HashTag Technologies — environment configuration
# Copy to ".env" (same folder) OR, preferably, one level ABOVE the web
# root (e.g. /home/USER/.env) so it can never be served over HTTP.
# ------------------------------------------------------------------

APP_ENV=production            # production | development
APP_DEBUG=true
APP_URL=http://127.0.0.1:8080
APP_TIMEZONE=Asia/Kolkata
APP_KEY=a14e269e131ad5902e36f8ab5cb55ff8412083a1526b53830bea85c463c9981e

# Database: mysql (production) or sqlite (zero-config local preview)
DB_DRIVER=sqlite
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hashtag_site
DB_USER=hashtag_user
DB_PASS=
DB_SQLITE_PATH=storage/database.sqlite

# Mail — MAIL_DRIVER=mail uses PHP mail(); smtp uses the built-in SMTP client
MAIL_DRIVER=log
MAIL_FROM=support@primaryinfotech.com
MAIL_FROM_NAME="HashTag Technologies"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=tls               # tls | ssl | none

# Uploads
UPLOAD_MAX_MB=5

# Admin security
ADMIN_SESSION_MINUTES=60
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
